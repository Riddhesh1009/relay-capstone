# Postgres
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# API auth (single demo token, per API_CONTRACT.md)
DEMO_TOKEN=demo-token-123

# Mock external world (scripts/mock_world.py --port 9210)
MOCK_WORLD_URL=http://localhost:9210

# Mock LLM provider (scripts/mock_provider.py)
# AI_PROVIDER options:
#   heuristic  - local keyword-based classifier, produces real schema-conformant
#                JSON for demos (default; no network call, deterministic)
#   mock       - talks to scripts/mock_provider.py; returns free-text prose,
#                useful for exercising timeouts/retries/auth, NOT for schema demos
#   anthropic  - a real model, requires ANTHROPIC_API_KEY
#   openai     - a real model, requires OPENAI_API_KEY

AI_PROVIDER=heuristic
MOCK_PROVIDER_URL=http://localhost:9211

# Real provider, only used if AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Real provider, only used if AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# Engine
PORT=8080
WORKER_POLL_MS=500
DEFAULT_TIMEOUT_MS=8000
