{
  "name": "relay",
  "version": "1.0.0",
  "description": "AI workflow orchestrator - durable execution, approval gates, AI decision nodes",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "start": "node src/server.js",
    "worker": "node src/engine/worker.js",
    "dev": "concurrently -n api,worker -c blue,green \"node src/server.js\" \"node src/engine/worker.js\"",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
